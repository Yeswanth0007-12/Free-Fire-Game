# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR FREE FIRE COMPETITIVE TOURNAMENT PLATFORM
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true

# Database (Supabase PostgreSQL / Cloud Postgres)
# Format for Supabase: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
# Format for local SQLite: sqlite+aiosqlite:///./tournament.db
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/tournament_db

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Security & JWT Tokens (Must be minimum 32 random characters in production)
JWT_SECRET=production_secret_jwt_encryption_key_change_me_immediately_12345
JWT_REFRESH_SECRET=production_secret_jwt_refresh_key_change_me_immediately_12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Room Credential AES-256 Symmetric Encryption Key
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=v3y8Z7x0W9uA1bC2dE3fG4hI5jK6lM7nO8pQ9rS0tU=

# Razorpay Payment Gateway (India UPI/Cards/Netbanking)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# Feature Flags & Regulatory Compliance
WITHDRAWALS_ENABLED=false
REAL_MONEY_ENABLED=false
PUBLIC_LAUNCH_ENABLED=false
SLOT_RESERVATION_TIMEOUT_SECONDS=300

# CORS & Network Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Sentry Monitoring & Error Tracking (Optional)
SENTRY_DSN=

# Frontend Configuration (In frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
